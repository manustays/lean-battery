{
	"branches": ["main"],
	"plugins": [
		"@semantic-release/commit-analyzer",
		"@semantic-release/release-notes-generator",
		"@semantic-release/changelog",
		["@semantic-release/exec", {
			"prepareCmd": "scripts/set-version.sh ${nextRelease.version} && swift test && make zip && scripts/verify-release.sh ${nextRelease.version}"
		}],
		["@semantic-release/github", {
			"assets": [{ "path": "dist/LeanBattery-*.zip", "label": "LeanBattery (macOS 26+, Apple Silicon)" }]
		}],
		["@semantic-release/git", {
			"assets": ["CHANGELOG.md", "Resources/Info.plist"],
			"message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
		}]
	]
}
